# ADC 鉴权。先执行：
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project YOUR_PROJECT_ID
#   gcloud services enable aiplatform.googleapis.com --project YOUR_PROJECT_ID
GOOGLE_CLOUD_PROJECT=
# Live 对话模型是区域接口，默认 us-central1，不是 TTS 常用的 global。
# Transcribe Live（gemini-3.5-transcribe-live-preview）官方区域是 global，工作台会自动改。
GOOGLE_CLOUD_LOCATION=us-central1
# 本机端口。Cloud Run 使用平台注入的 PORT。
DEMO_PORT=8003
# 可选：自定义域名 Host（逗号分隔）。Cloud Run 会自动允许 *.run.app。
# ALLOWED_HOSTS=demo.example.com
